 "defs": [
  {
   "id": "contribution",
   "name": "Contribuição",
   "group": "financial",
   "tier": 1,
   "unit": "R$ mi",
   "dir": "max",
   "decimals": 1,
   "definition": "Resultado do terminal depois do custo operacional, comparado com a contribuição orçada para o volume orçado.",
   "formula": "receita alocada − OPEX; meta = volume orçado × (receita-meta − custo-meta por tonelada)",
   "owner": "Finanças",
   "frequency": "Mensal",
   "agg": "sum",
   "why": "É o resultado que o terminal gera antes dos custos corporativos. Compara o que sobrou com o que foi orçado e mostra se o desvio vem de volume, preço ou custo.",
   "pillar": "Resultado",
   "targetSeries": "contributionBudget",
   "tol": 0.05,
   "drivers": [
    "yield",
    "costPerT",
    "throughput"
   ],
   "scale": 1000000
  },
  {
   "id": "margin",
   "name": "Margem de contribuição",
   "group": "financial",
   "tier": 1,
   "unit": "%",
   "dir": "max",
   "decimals": 1,
   "definition": "Quanto da receita alocada sobra depois do custo operacional do terminal.",
   "formula": "(receita alocada − OPEX) ÷ receita alocada × 100; meta derivada das metas de receita e de custo por tonelada",
   "owner": "Finanças",
   "frequency": "Mensal",
   "agg": "ratio",
   "why": "Mostra quanto de cada real de receita sobra. Cai quando o custo sobe ou o preço cai, e independe do volume.",
   "pillar": "Resultado",
   "targetKey": "margin",
   "tol": 0.05,
   "drivers": [
    "yield",
    "costPerT"
   ]
  },
  {
   "id": "costPerT",
   "name": "Custo por tonelada",
   "group": "financial",
   "tier": 1,
   "unit": "R$/t",
   "dir": "min",
   "decimals": 0,
   "definition": "Custo operacional por tonelada processada.",
   "formula": "OPEX ÷ toneladas processadas",
   "owner": "Controladoria",
   "frequency": "Mensal",
   "agg": "ratio",
   "why": "É o principal indicador de eficiência: quanto custa mover uma tonelada. Compara terminais de portes diferentes.",
   "pillar": "Custo",
   "targetKey": "costPerT",
   "tol": 0.05,
   "drivers": [
    "productivity",
    "occupancy",
    "truckTurn"
   ]
  },
  {
   "id": "occupancy",
