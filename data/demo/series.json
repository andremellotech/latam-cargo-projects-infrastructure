   "group": "operational",
   "tier": 1,
   "unit": "%",
   "dir": "min",
   "decimals": 1,
   "definition": "Quanto da capacidade mensal do terminal foi utilizada.",
   "formula": "toneladas processadas ÷ capacidade mensal × 100",
   "owner": "Operações",
   "frequency": "Mensal",
   "agg": "ratio",
   "why": "Acima da meta, o terminal perde folga para picos e o serviço piora; abaixo, há capacidade ociosa. Decide quando expandir.",
   "pillar": "Capacidade",
   "targetKey": "occupancy",
   "tol": 0.04,
   "drivers": [
